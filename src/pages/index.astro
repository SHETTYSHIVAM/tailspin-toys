---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';
import { getAllCategories } from '../lib/categories';
import { getAllPublishers } from '../lib/publishers';

export const prerender = true;

const db = getDatabase();
const [games, categories, publishers] = await Promise.all([
  getAllGames(db),
  getAllCategories(db),
  getAllPublishers(db),
]);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <form class="mb-8 grid gap-6 rounded-xl border border-slate-700 bg-slate-800/50 p-6 backdrop-blur-sm md:grid-cols-2" data-testid="game-filters">
            <div>
              <label for="category-filter" class="mb-2 block font-medium text-slate-100">Filter by category</label>
              <select
                id="category-filter"
                name="categories"
                multiple
                class="min-h-32 w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                data-testid="category-filter"
                aria-describedby="category-filter-help"
              >
                {categories.map((category) => <option value={category.id}>{category.name}</option>)}
              </select>
              <p id="category-filter-help" class="mt-2 text-sm text-slate-400">Hold Ctrl or Command to choose multiple categories.</p>
            </div>

            <div>
              <label for="publisher-filter" class="mb-2 block font-medium text-slate-100">Filter by publisher</label>
              <select
                id="publisher-filter"
                name="publisher"
                class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                data-testid="publisher-filter"
              >
                <option value="">All publishers</option>
                {publishers.map((publisher) => <option value={publisher.id}>{publisher.name}</option>)}
              </select>
            </div>

            <div class="md:col-span-2 flex flex-wrap items-center gap-4">
              <button
                type="reset"
                class="rounded-lg bg-blue-600 px-4 py-2 font-medium text-white transition-colors hover:bg-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                data-testid="clear-filters"
              >
                Clear filters
              </button>
              <p class="text-sm text-slate-300" data-testid="filter-status" role="status" aria-live="polite">
                Showing {games.length} games
              </p>
            </div>
          </form>

          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>

          <div class="hidden mt-6" data-testid="filtered-empty-state">
            <EmptyState text="No games match the selected filters." />
          </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const filters = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
  const categoryFilter = document.querySelector<HTMLSelectElement>('[data-testid="category-filter"]');
  const publisherFilter = document.querySelector<HTMLSelectElement>('[data-testid="publisher-filter"]');
  const filterStatus = document.querySelector<HTMLElement>('[data-testid="filter-status"]');
  const emptyState = document.querySelector<HTMLElement>('[data-testid="filtered-empty-state"]');
  const gameCards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));

  if (filters && categoryFilter && publisherFilter && filterStatus && emptyState) {
    const updateGameVisibility = (): void => {
      const selectedCategories = new Set(Array.from(categoryFilter.selectedOptions, (option) => option.value));
      const selectedPublisher = publisherFilter.value;
      let visibleCount = 0;

      for (const card of gameCards) {
        const categoryMatches =
          selectedCategories.size === 0 || selectedCategories.has(card.dataset.categoryId ?? '');
        const publisherMatches =
          selectedPublisher === '' || selectedPublisher === (card.dataset.publisherId ?? '');
        const isVisible = categoryMatches && publisherMatches;

        card.hidden = !isVisible;
        if (isVisible) {
          visibleCount++;
        }
      }

      emptyState.classList.toggle('hidden', visibleCount > 0);
      filterStatus.textContent = `Showing ${visibleCount} ${visibleCount === 1 ? 'game' : 'games'}`;
    };

    categoryFilter.addEventListener('change', updateGameVisibility);
    publisherFilter.addEventListener('change', updateGameVisibility);
    filters.addEventListener('reset', () => {
      window.setTimeout(updateGameVisibility);
    });
  }
</script>
